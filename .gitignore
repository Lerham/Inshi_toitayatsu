# Private source material
# The Notion export can contain private/admin pages, workspace IDs, page IDs,
# comments, and files that are not intended for redistribution.
/プライベート、シェア/

# Unsorted source files remain local. Curated images under each answer's
# source-images directory are intentionally public for transcription review.
**/source-files/

# Application reports include documents written by other people and must not
# be published with the entrance-exam study notes.
/Inshi_Taisaku_Note/[[]GANSHO_REPORT[]]/

# Private or omitted chapters from the entrance-exam study notes.
/Inshi_Taisaku_Note/[[]IroIro[]]/Research.tex
/Inshi_Taisaku_Note/[[]IroIro[]]/PREVIOUS_EXAM.tex
/Inshi_Taisaku_Note/[[]IroIro[]]/English.tex
/Inshi_Taisaku_Note/[[]IroIro[]]/Zatta_Quiz.tex
/Inshi_Taisaku_Note/[[]IroIro[]]/memo.tex

